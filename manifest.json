{
    "manifest_version":3,
    "name":"Tab Saver",
    "short_name":"Tab Saver",
    "description":"Save open tab URLs and view them later in the extension popup.",
    "version":"1.0",
    "permissions":["tabs","storage"],
    "action":{
        "default_popup":"popup.html",
        "default_title":"Tab Saver"
    }
}
